# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL='postgres://postgres:postgres@localhost:35432/cb'

# ── URLs ───────────────────────────────────────────────────────────────────────
# DEPLOY_URL: base URL of this deployment, no protocol — used in magic link emails
# and to derive the GraphQL endpoint in server-side rendering.
# In production Vercel deployments, falls back to VERCEL_URL if not set.

DEPLOY_URL="localhost:3000"

# ── Authentication ─────────────────────────────────────────────────────────────
# COOKIE_SECRET: long random string used to sign session cookies
# MAGIC_LINK_SECRET: signs magic-link tokens — use a different value per environment
# MAGIC_LINK_TIME_LIMIT: link expiry in seconds (900 = 15 min)
# ALLOW_REUSE_LOGIN_LINK: set to 1 to allow link reuse — dev/testing only

COOKIE_SECRET="A_LONG_RANDOM_VALUE_THAT_IS_NOT_THIS_STRING"
MAGIC_LINK_SECRET="A_LONG_RANDOM_VALUE_THAT_IS_NOT_THIS_STRING"
MAGIC_LINK_TIME_LIMIT=900
#ALLOW_REUSE_LOGIN_LINK=1

# ── Email ──────────────────────────────────────────────────────────────────────
# POSTMARK_API_TOKEN: server API token for transactional email (magic links etc.)
# POSTMARK_BROADCAST_API_TOKEN: separate Postmark message stream for bulk/broadcast email
# FROM_EMAIL: sender address shown on all outgoing emails

POSTMARK_API_TOKEN="A_POSTMARK_SERVER_API_TOKEN"
#POSTMARK_BROADCAST_API_TOKEN=""
FROM_EMAIL="fake@example.com"

# ── Platform branding (optional) ───────────────────────────────────────────────
# Override the platform name and bucket terminology displayed in the UI.

#PLATFORM_NAME="Cobudget"
#BUCKET_NAME_SINGULAR="Bucket"
#BUCKET_NAME_PLURAL="Buckets"

# ── Round & member limits (optional) ───────────────────────────────────────────
# Controls how many buckets/members are allowed on free vs paid rounds.
# Defaults apply if unset — set explicitly when running without Stripe.

#MAX_FREE_BUCKETS=1
#MAX_PAID_BUCKETS=10000
#FREE_ROUND_MEMBERS_LIMIT=5
#PAID_ROUND_MEMBERS_LIMIT=20

# ── OAuth — Facebook (optional) ────────────────────────────────────────────────
# Not required; omitting these suppresses the Facebook login button entirely.
# Use separate app IDs for dev and prod environments.

#FACEBOOK_APP_ID=
#FACEBOOK_APP_SECRET=

# ── OAuth — Google (optional) ──────────────────────────────────────────────────
# Not required; omitting these suppresses the Google login button entirely.

#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# ── reCAPTCHA (optional) ───────────────────────────────────────────────────────
# Server-side secret key for reCAPTCHA v3 verification.
# Set SKIP_RECAPTCHA=true in local dev to bypass verification without keys.

#RECAPTCHA_SECRET_KEY=""
#SKIP_RECAPTCHA=true

# ── Stripe (optional) ──────────────────────────────────────────────────────────
# Required only if paid tier / subscription billing is enabled.

#STRIPE_API_KEY=
#STRIPE_ACCOUNT_WEBHOOK_SECRET=
#STRIPE_CONNECT_WEBHOOK_SECRET=
#STRIPE_MONTHLY_PLAN_PRICE_ID=
#STRIPE_YEARLY_PLAN_PRICE_ID=

