# ── Crowdin (optional) ─────────────────────────────────────────────────────────
# Translation management integration — not required for development.

#CROWDIN_PROJECT_ID=
#CROWDIN_API_TOKEN=

# ── Terms of service (optional) ────────────────────────────────────────────────
# ISO timestamp of the last T&C update — when set, users must re-accept on next login.

#TERMS_UPDATED_AT="2022-05-30T20:18:35.225Z"

# ── Landing page (optional) ────────────────────────────────────────────────────
#LANDING_PAGE_URL="https://cobudget.webflow.io"

# ── Error reporting (optional) ─────────────────────────────────────────────────
# Discord webhook URL — posts server-side errors as messages to a channel.

#ERROR_REPORTING_WEBHOOK=
